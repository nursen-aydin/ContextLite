# ContextLite Environment Variables Example
# Boş bırakılırsa ilk çalıştırmada data/.encryption_key otomatik oluşturulur.
# Üretimde isterseniz Fernet anahtarını burada açıkça tanımlayın.
ENCRYPTION_KEY=

# İsteğe bağlı model seçimi. Boşsa uygulama yüklü/önbellekteki en uygun modeli seçer.
FOUNDRY_CHAT_MODEL=phi-3.5-mini
FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b
FOUNDRY_DATA_DIR=data/foundry

# E-posta Sağlayıcısı (Transactional Email Service)
# Üretim için Resend, SendGrid, Mailgun veya AWS SES gibi servislerin SMTP bilgilerini girin.
MAIL_PROVIDER=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=true
MAIL_FROM="noreply@example.com"
MAIL_FROM_NAME="ContextLite"
APP_BASE_URL="http://127.0.0.1:8124"
